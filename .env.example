# Application Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local Replica Set)
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dawwarha

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Frontend Client URL / Allowed CORS Origins (comma-separated for multiple origins)
# In production on Hostinger: https://dawwarha.com,https://www.dawwarha.com
CLIENT_URL=http://localhost:4200

# Environment Mode (development | production | test)
NODE_ENV=development
